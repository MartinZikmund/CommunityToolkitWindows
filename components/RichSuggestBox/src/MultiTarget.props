<Project>
    <PropertyGroup>
        <!--
          MultiTarget is a custom property that indicates which target a project is designed to be built for / run on.
          Used to create project references, generate solution files, enable/disable TargetFrameworks, and build nuget packages.
        -->
        <MultiTarget>uwp;wasdk;wpf;win32;wasm;linux;macos;ios;android;</MultiTarget>
    </PropertyGroup>
    <!-- On Uno 5 Apple targets controls are UIViews, whose Window, Paste and Description clash with RichSuggestBox members -->
    <PropertyGroup Condition="'$(WinUIMajorVersion)' == '2'">
        <MultiTarget>uwp;wpf;wasm;linux;android;</MultiTarget>
    </PropertyGroup>
</Project>
